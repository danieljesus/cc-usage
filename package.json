{
  "name": "cc-usage",
  "private": true,
  "version": "0.1.0",
  "description": "cc-usage — near-real-time monitor for Claude Code's 5h/7d usage windows.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cc-usage": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
